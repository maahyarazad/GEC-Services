{
  "apps": [
    {
      "name": "GEC Services",
      "script": "server.js",
      "cwd": ".",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "merge_logs": true,
      "time": true,
      "out_file": "logs/pm2-out.log",
      "error_file": "logs/pm2-error.log",
      "env": {
        "ENVIRONMENT": "DEV"
      }
    }
  ]
}
